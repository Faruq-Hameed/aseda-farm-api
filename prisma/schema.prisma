generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MANAGER
  WORKER
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  phone         String?
  role          String    @default("OWNER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  farm          Farm?
  memberships   FarmMember[] @relation("UserMemberships")
  addedMembers  FarmMember[] @relation("AddedByUser")
  notifications Notification[]
  activityLogs  ActivityLog[]
  changeLogs    ChangeLog[]
}

model Farm {
  id         String   @id @default(cuid())
  name       String   @default("ASEDA Farm")
  location   String   @default("Adesiyan Village, Olojuoro Road, Ibadan")
  totalAcres Float    @default(5.0)
  ownerId    String   @unique
  owner      User     @relation(fields: [ownerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  batches    Batch[]
  tasks      Task[]
  activities ActivityLog[]
  expenses   Expense[]
  harvests   Harvest[]
  members    FarmMember[]
}

model FarmMember {
  id        String     @id @default(cuid())
  farmId    String
  userId    String
  role      MemberRole @default(WORKER)
  addedById String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  farm    Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user    User @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User @relation("AddedByUser", fields: [addedById], references: [id])

  @@unique([farmId, userId])
}

model Batch {
  id                   String    @id @default(cuid())
  farmId               String
  farm                 Farm      @relation(fields: [farmId], references: [id])
  name                 String
  plantCount           Int
  plantingDate         DateTime
  variety              String    @default("Agbagba")
  spacing              String    @default("3m x 2m")
  acresCovered         Float
  status               String    @default("growing")
  expectedHarvestStart DateTime?
  expectedHarvestEnd   DateTime?
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tasks          Task[]
  activities     ActivityLog[]
  harvests       Harvest[]
  suckerHarvests SuckerHarvest[]
}

model Task {
  id          String    @id @default(cuid())
  farmId      String
  farm        Farm      @relation(fields: [farmId], references: [id])
  batchId     String?
  batch       Batch?    @relation(fields: [batchId], references: [id])
  title       String
  description String?   @db.Text
  category    String
  status      String    @default("pending")
  priority    String    @default("medium")
  dueDate     DateTime
  completedAt DateTime?
  completedBy String?
  product     String?
  quantity    String?
  cost        Float?
  notes       String?   @db.Text
  isRecurring Boolean   @default(false)
  recurEvery  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  notifications Notification[]
}

model ActivityLog {
  id          String   @id @default(cuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id])
  batchId     String?
  batch       Batch?   @relation(fields: [batchId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String
  title       String
  description String   @db.Text
  product     String?
  quantity    String?
  cost        Float?
  plantCount  Int?
  date        DateTime @default(now())
  photos      String[]
  weather     String?
  createdAt   DateTime @default(now())
}

model Harvest {
  id             String   @id @default(cuid())
  farmId         String
  farm           Farm     @relation(fields: [farmId], references: [id])
  batchId        String
  batch          Batch    @relation(fields: [batchId], references: [id])
  harvestDate    DateTime
  bunchCount     Int
  avgBunchWeight Float?
  totalWeight    Float?
  pricePerBunch  Float?
  totalRevenue   Float?
  buyer          String?
  channel        String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
}

model SuckerHarvest {
  id             String   @id @default(cuid())
  batchId        String
  batch          Batch    @relation(fields: [batchId], references: [id])
  harvestDate    DateTime
  suckerCount    Int
  method         String
  soldCount      Int?     @default(0)
  pricePerSucker Float?
  revenue        Float?
  replantedCount Int?     @default(0)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  category  String
  item      String
  amount    Float
  date      DateTime
  vendor    String?
  batchId   String?
  notes     String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NotificationSetting {
  id              String   @id @default(cuid())
  userId          String   @unique
  emailEnabled    Boolean  @default(true)
  emailDaysBefore Int      @default(3)
  dailyDigest     Boolean  @default(true)
  digestTime      String   @default("07:00")
  overdueAlerts   Boolean  @default(true)
  harvestAlerts   Boolean  @default(true)
  weeklyReport    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChangeLog {
  id         String   @id @default(cuid())
  entityType String   // Batch, Task, ActivityLog, Harvest, SuckerHarvest, Expense
  entityId   String
  action     String   // create, update, delete
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  summary    String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}
